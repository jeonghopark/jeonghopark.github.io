---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeCanvas from '../../components/ThreeCanvas.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const post = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
	<article class="prose prose-invert prose-lg max-w-none">
        <header class="mb-10 text-center not-prose">
            <h1 class="text-4xl font-extrabold mb-4">{post.data.title}</h1>
             <div class="text-gray-500 text-sm">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
        </header>
        {post.data.img && (
            <img src={`/assets/images/${post.data.img}`} alt={post.data.title} class="w-full rounded-xl shadow-2xl mb-12 border border-white/10" />
        )}
		<Content components={{ ThreeCanvas }} />
	</article>
</BaseLayout>
