---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="JeongHo Park">
	<section class="mt-12">
        <h1 class="text-xs text-gray-500 uppercase tracking-widest mb-12 pl-1">Selected Works</h1>
		<div class="flex flex-col gap-8">
			{posts.map((post) => (
				<a href={`/blog/${post.slug}/`} class="group block border-t border-white/10 pt-8 pb-4 hover:border-white transition-colors duration-300">
					<article class="flex flex-col md:flex-row md:items-baseline justify-between gap-2">
						<h2 class="text-xl font-medium text-white group-hover:text-gray-300 transition-colors">
							{post.data.title}
						</h2>
                        <time class="text-sm font-mono text-gray-600 group-hover:text-gray-400 transition-colors whitespace-nowrap">
						    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                        </time>
					</article>
                    {post.data.description && (
                        <p class="mt-2 text-sm text-gray-500 max-w-xl group-hover:text-gray-400 transition-colors">
                            {post.data.description}
                        </p>
                    )}
				</a>
			))}
		</div>
	</section>
</BaseLayout>
